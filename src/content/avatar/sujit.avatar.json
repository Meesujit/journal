{
  "schema": "bible-strong/avatar-definition",
  "schemaVersion": 1,
  "name": "Sujit's assistant avatar",
  "body": {
    "primary": {
      "type": "mickey",
      "width": 220,
      "height": 220,
      "depth": 220,
      "roundness": 0.35
    },
    "nodes": []
  },
  "colors": {
    "body": "#1f6feb",
    "eyes": "#0a0f1a"
  },
  "expressions": {
    "neutral": {
      "head": { "x": 0, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 26, "height": 30, "x": -38, "y": -6, "angle": 0 },
        "right": { "width": 26, "height": 30, "x": 38, "y": -6, "angle": 0 },
        "spacing": 76
      },
      "perspective": 2.4,
      "motion": { "eyes": "microSaccades", "body": "none" }
    },
    "look-left": {
      "head": { "x": -4, "y": -15, "z": -4 },
      "eyes": {
        "left": { "width": 26, "height": 30, "x": -38, "y": -6, "angle": 0 },
        "right": { "width": 26, "height": 30, "x": 38, "y": -6, "angle": 0 },
        "spacing": 76
      },
      "perspective": 2.4,
      "motion": { "eyes": "none", "body": "none" }
    },
    "look-right": {
      "head": { "x": -4, "y": 15, "z": 4 },
      "eyes": {
        "left": { "width": 26, "height": 30, "x": -38, "y": -6, "angle": 0 },
        "right": { "width": 26, "height": 30, "x": 38, "y": -6, "angle": 0 },
        "spacing": 76
      },
      "perspective": 2.4,
      "motion": { "eyes": "none", "body": "none" }
    },
    "thinking": {
      "head": { "x": 10, "y": -18, "z": 10 },
      "eyes": {
        "left": { "width": 24, "height": 20, "x": -38, "y": -10, "angle": -6 },
        "right": { "width": 24, "height": 20, "x": 38, "y": -10, "angle": 6 },
        "spacing": 76
      },
      "perspective": 2.4,
      "motion": { "eyes": "none", "body": "slowDrift" }
    },
    "talking": {
      "head": { "x": 0, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 28, "height": 24, "x": -38, "y": -4, "angle": 0 },
        "right": { "width": 28, "height": 24, "x": 38, "y": -4, "angle": 0 },
        "spacing": 76
      },
      "perspective": 2.4,
      "motion": { "eyes": "microSaccades", "body": "shake" }
    }
  },
  "expressionOrder": ["neutral", "look-left", "look-right", "thinking", "talking"],
  "animations": {
    "idle": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "neutral", "holdMs": 2600, "transitionMs": 700, "transition": "spring" },
        { "expression": "look-right", "holdMs": 1800, "transitionMs": 700, "transition": "spring" },
        { "expression": "neutral", "holdMs": 2600, "transitionMs": 700, "transition": "spring" },
        { "expression": "look-left", "holdMs": 1800, "transitionMs": 700, "transition": "spring" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 1200,
        "minIntervalMs": 2500,
        "maxIntervalMs": 6000,
        "durationMs": 160
      },
      "metadata": { "label": "Idle", "group": "widget" }
    },
    "thinking": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "thinking", "holdMs": 900, "transitionMs": 400, "transition": "smooth" },
        { "expression": "neutral", "holdMs": 500, "transitionMs": 400, "transition": "smooth" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 2000,
        "minIntervalMs": 3000,
        "maxIntervalMs": 7000,
        "durationMs": 140
      },
      "metadata": { "label": "Thinking", "group": "widget" }
    },
    "talking": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "talking", "holdMs": 260, "transitionMs": 120, "transition": "snappy" },
        { "expression": "neutral", "holdMs": 220, "transitionMs": 120, "transition": "snappy" }
      ],
      "blink": {
        "enabled": true,
        "initialDelayMs": 1500,
        "minIntervalMs": 2500,
        "maxIntervalMs": 5000,
        "durationMs": 140
      },
      "metadata": { "label": "Talking", "group": "widget" }
    }
  },
  "animationOrder": ["idle", "thinking", "talking"]
}
